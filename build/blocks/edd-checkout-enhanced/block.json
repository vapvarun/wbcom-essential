{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wbcom-essential/edd-checkout-enhanced",
  "version": "3.0.0",
  "title": "EDD Enhanced Checkout (legacy)",
  "category": "essential-edd",
  "icon": "cart",
  "description": "Legacy wrapper kept only so pages saved before 4.7.0 keep rendering. Use the EDD Checkout block with the Wbcom checkout sections inside it instead.",
  "keywords": [
    "edd",
    "checkout",
    "payment",
    "cart",
    "easy digital downloads",
    "essential",
    "wbcom"
  ],
  "textdomain": "wbcom-essential",
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    },
    "inserter": false
  },
  "attributes": {
    "showProgressBar": {
      "type": "boolean",
      "default": false
    },
    "showTrustBadges": {
      "type": "boolean",
      "default": true
    },
    "trustBadgeText": {
      "type": "string",
      "default": "Secure checkout"
    },
    "guaranteeDays": {
      "type": "number",
      "default": 14
    },
    "guaranteeText": {
      "type": "string",
      "default": "Covered by our money-back guarantee."
    },
    "showReviews": {
      "type": "boolean",
      "default": true
    },
    "reviewCount": {
      "type": "number",
      "default": 3
    },
    "showRecommendations": {
      "type": "boolean",
      "default": true
    },
    "recommendationCount": {
      "type": "number",
      "default": 3
    },
    "showTrustpilot": {
      "type": "boolean",
      "default": true
    },
    "trustpilotRating": {
      "type": "number",
      "default": 0
    },
    "trustpilotCount": {
      "type": "number",
      "default": 0
    },
    "trustpilotUrl": {
      "type": "string",
      "default": ""
    },
    "trustpilotReviews": {
      "type": "array",
      "default": []
    },
    "paymentIcons": {
      "type": "object",
      "default": {
        "visa": false,
        "mastercard": false,
        "paypal": false,
        "stripe": false,
        "razorpay": false
      }
    },
    "uniqueId": {
      "type": "string",
      "default": ""
    },
    "padding": {
      "type": "object",
      "default": {
        "top": 24,
        "right": 24,
        "bottom": 24,
        "left": 24
      }
    },
    "paddingTablet": {
      "type": "object",
      "default": null
    },
    "paddingMobile": {
      "type": "object",
      "default": null
    },
    "paddingUnit": {
      "type": "string",
      "default": "px"
    },
    "margin": {
      "type": "object",
      "default": {
        "top": 0,
        "right": 0,
        "bottom": 0,
        "left": 0
      }
    },
    "marginTablet": {
      "type": "object",
      "default": null
    },
    "marginMobile": {
      "type": "object",
      "default": null
    },
    "marginUnit": {
      "type": "string",
      "default": "px"
    },
    "boxShadow": {
      "type": "boolean",
      "default": false
    },
    "shadowHorizontal": {
      "type": "number",
      "default": 0
    },
    "shadowVertical": {
      "type": "number",
      "default": 4
    },
    "shadowBlur": {
      "type": "number",
      "default": 8
    },
    "shadowSpread": {
      "type": "number",
      "default": 0
    },
    "shadowColor": {
      "type": "string",
      "default": "rgba(0, 0, 0, 0.12)"
    },
    "borderRadius": {
      "type": "object",
      "default": {
        "top": 0,
        "right": 0,
        "bottom": 0,
        "left": 0
      }
    },
    "borderRadiusUnit": {
      "type": "string",
      "default": "px"
    },
    "hideOnDesktop": {
      "type": "boolean",
      "default": false
    },
    "hideOnTablet": {
      "type": "boolean",
      "default": false
    },
    "hideOnMobile": {
      "type": "boolean",
      "default": false
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}