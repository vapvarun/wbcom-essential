includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon
	- phpstan-baseline.neon

parameters:
	level: 5

	paths:
		- admin
		- includes
		- plugins
		- templates
		- scripts
		- loader.php
		- wbcom-essential.php
		- uninstall.php

	excludePaths:
		analyseAndScan:
			- vendor
			- node_modules (?)
			- build
			- dist (?)
			- assets/vendor
			# Standalone CLI check that stands in for a few WordPress functions; analysing it would shadow the real ones.
			- scripts/check-login-security-ip.php

	# Analysis-only sources. Elementor has no stubs package on Packagist, so the
	# real plugin is downloaded (never committed - see .gitignore) and scanned
	# for symbols only. Without this, all 43 Elementor widgets report every
	# inherited method as undefined, and the analysis is worthless noise.
	#
	# Fetch with: bash bin/phpstan-fetch-deps.sh
	scanDirectories:
		- .phpstan-stubs/elementor
		# Bundled licensing SDK and package signatures: read for their symbols only, never analysed as our code.
		- libs

	# EDD 3 classes used by the EDD blocks; EDD is optional and not installed for analysis.
	scanFiles:
		- phpstan-edd-stubs.php

	bootstrapFiles:
		- phpstan-constants.php
		- vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php

	treatPhpDocTypesAsCertain: false
	reportUnmatchedIgnoredErrors: false

	ignoreErrors:
		# The EDD SDK that runs is whichever bundled copy has the highest version on the site, so it may be another
		# plugin's copy without set_fallback(). PHPStan only sees ours (libs/), where the method always exists.
		-
			message: '#^Call to function method_exists\(\) with .+ and .set_fallback. will always evaluate to true\.$#'
			path: loader.php
			count: 1
		# BuddyPress, bbPress and EDD are optional integrations, gated at runtime
		# by class_exists() / function_exists(). They are not installed for
		# analysis, so their symbols are legitimately unknown. Anything NOT
		# matched here is a real unknown symbol and must fail the build.
		- '#^Function (bp_|bbp_|edd_|groups_|friends_|messages_|xprofile_|buddypress|bbpress)[A-Za-z0-9_]* not found\.$#'
		- '#^Used function (bp_|bbp_|edd_|buddypress)[A-Za-z0-9_]* not found\.$#'
		- '#unknown class (BuddyPress|bbPress|BP_[A-Za-z_]+|EDD_[A-Za-z_]+)\.$#'
		- '#^(Class|Instantiated class|Parameter .* has invalid type) (BuddyPress|bbPress|BP_[A-Za-z_]+|EDD_[A-Za-z_]+)( not found)?\.$#'
		- '#^Constant (BP_|BBP_|EDD_)[A-Z0-9_]+ not found\.$#'

	parallel:
		maximumNumberOfProcesses: 2
