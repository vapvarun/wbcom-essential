{
    "name": "wbcom-essential/wbcom-essential",
    "description": "Theme Addon plugin for Wbcom Designs",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Varun Dubey",
            "email": "varun@wbcomdesigns.com"
        }
    ],
    "repositories": {
        "edd-sl-sdk": {
            "type": "vcs",
            "url": "https://github.com/awesomemotive/edd-sl-sdk"
        }
    },
    "require": {
        "php": ">=7.4",
        "easy-digital-downloads/edd-sl-sdk": "^1.0.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-parallel-lint/php-parallel-lint": "^1.3",
        "wp-coding-standards/wpcs": "^3.4.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^2.0",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "phpcsstandards/phpcsextra": "^1.2",
        "squizlabs/php_codesniffer": "^3.13.6",
        "php-stubs/woocommerce-stubs": "^9.0"
    },
    "scripts": {
        "lint": "@php ./vendor/bin/parallel-lint --exclude .git --exclude vendor --exclude node_modules --exclude .phpstan-stubs .",
        "phpcs": "@php ./vendor/bin/phpcs",
        "phpcbf": "@php ./vendor/bin/phpcbf",
        "phpstan": "@php ./vendor/bin/phpstan analyse --memory-limit=2G",
        "phpstan:deps": "bash bin/phpstan-fetch-deps.sh",
        "audit:sec": "@composer audit",
        "qa": [
            "@lint",
            "@phpcs",
            "@phpstan"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
