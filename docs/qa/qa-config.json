{
	"$schema": "https://wpmediaverse.com/schemas/wp-plugin-qa-config-v1.json",
	"slug": "wbcom-essential",
	"name": "Wbcom Essential",
	"base_url": "http://localhost:10048",
	"autologin_param": "autologin",
	"personas": {
		"admin": "1"
	},
	"modes": [
		"single"
	],
	"report_path": "docs/qa/.last-smoke-pass.json",
	"checks": {
		"release": {
			"domain": "wbcom-essential",
			"excluded": [ "plugins/gutenberg/src", "docs", "plan", "audit", "marketing", "scripts", "bin" ]
		},
		"crawl": [
			{ "url": "/", "persona": "admin", "root": "main" }
		]
	}
}
